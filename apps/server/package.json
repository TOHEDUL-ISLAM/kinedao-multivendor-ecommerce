    "@kineDao.com/env": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.39",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.2",
