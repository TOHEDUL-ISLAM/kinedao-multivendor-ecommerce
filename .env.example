# Server Configuration
NODE_ENV="development"
PORT="3000"

# Database (Neon Pooled Connection)
DATABASE_URL="postgres://user:password@ep-cool-snowflake-123456-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better-Auth
BETTER_AUTH_SECRET="your_32_character_minimum_secret_here"
BETTER_AUTH_URL="http://localhost:3000"

# Web Origin (Frontend)
WEB_ORIGIN="http://localhost:3001"
VITE_SERVER_URL="http://localhost:3000"
VITE_S3_PUBLIC_BASE_URL="https://your-public-r2-url.com"

# Storage (Cloudflare R2)
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
S3_PUBLIC_BASE_URL="https://your-public-r2-url.com"

# Email (Brevo SMTP)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-email@example.com"
SMTP_PASS="your_brevo_smtp_key"
EMAIL_FROM="noreply@yourdomain.com"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Social Providers (Optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
